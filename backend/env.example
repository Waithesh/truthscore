# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — .gitignore already excludes it.

PORT=3000

# Required — server-side only, never send these to the browser
YOUTUBE_API_KEY=
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to https://truthscore.online,https://www.truthscore.online if unset.
ALLOWED_ORIGINS=https://truthscore.online,https://www.truthscore.online

# Max /api/analyze requests per IP per 15-minute window (default 20)
RATE_LIMIT_MAX=20
